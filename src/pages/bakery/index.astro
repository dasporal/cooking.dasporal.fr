---
import Layout from "../../layouts/Layout.astro";
import { getRecipesBySection, slugifyTag } from "../../lib/recipes";

const recipes = getRecipesBySection("bakery");
---

<Layout title="Bakery | Daspie's recipes" description="Sweet baking and dessert recipes.">
  <section class="panel">
    <div class="section-divider mb-5 pb-4">
      <p class="meta-text text-xs uppercase tracking-[0.25em]">Section</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Bakery</h1>
      <p class="text-muted mt-2 text-sm sm:text-base">Desserts, cakes, biscuits, and baking basics.</p>
    </div>

    <ul class="space-y-3">
      {recipes.map((recipe) => (
        <li class="recipe-card">
          <a class="site-link text-lg font-bold underline decoration-2 underline-offset-2" href={recipe.url}>
            {recipe.title}
          </a>
          <div class="meta-text mt-1 text-xs uppercase tracking-[0.2em]">
            {recipe.date && new Date(recipe.date).toLocaleDateString("fr-FR")}
          </div>

          {recipe.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {recipe.tags.map((tag) => (
                <a class="tag-link" href={`/tags/${slugifyTag(tag)}/`}>
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  </section>
</Layout>
